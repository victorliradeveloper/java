# Template de variaveis de ambiente. NAO contem valores reais.
# Este arquivo VAI pro git como documentacao do que cada deploy precisa.
#
# Fluxo recomendado:
#   cp .env.example .env.dev    # preencha com credenciais de dev
#   cp .env.example .env.prod   # preencha com credenciais de prod (ou use Secret Manager)
#
# Rodar apontando pra um ambiente:
#   docker-compose --env-file .env.dev up
#   docker-compose --env-file .env.prod up
#
# Sem --env-file, o docker-compose carrega `.env` por default.

# === SMTP ===
# Dev (Gmail App Password):
#   1. Ative 2FA em https://myaccount.google.com/security
#   2. Gere uma App Password em https://myaccount.google.com/apppasswords
#   3. Cole no .env.dev (sem espacos)
# Prod: use um provedor transacional (SendGrid, SES, Mailgun) e credenciais
# de um secret manager — nao em arquivo .env.prod no disco.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-app-password-de-16-chars

# === Destinatario das notificacoes ===
# Dev: seu proprio email. Prod: mailing list de ops (ex: alerts@empresa.com).
NOTIFICATION_MAIL_TO=destinatario@exemplo.com
