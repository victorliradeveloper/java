# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# ─── Banco de Dados ───────────────────────────────────────────────
ORACLE_PASSWORD=oracle123
APP_USER=ecommerce
APP_USER_PASSWORD=ecommerce123

# ─── RabbitMQ ─────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=ecommerce
RABBITMQ_DEFAULT_PASS=ecommerce123

# ─── JWT ──────────────────────────────────────────────────────────
# Gere uma chave segura: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ─── Stripe ───────────────────────────────────────────────────────
# Obtenha em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_sua_chave_aqui

# ─── mTLS (opcional — ative com SPRING_PROFILES_ACTIVE=mtls) ─────
SSL_KEY_STORE_PASSWORD=changeit
SSL_TRUST_STORE_PASSWORD=changeit
SSL_CLIENT_KEY_STORE_PASSWORD=changeit
SSL_CLIENT_TRUST_STORE_PASSWORD=changeit

# ─── Deploy (GitHub Actions) ──────────────────────────────────────
# Configure como secrets no repositório:
# DEPLOY_HOST=ip-do-servidor
# DEPLOY_USER=ubuntu
# DEPLOY_SSH_KEY=<chave privada SSH>
