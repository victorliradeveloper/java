# Copie este arquivo como .env (mesmo diretório) e preencha com valores reais.
# O .env é lido automaticamente pelo `docker compose` e NÃO deve ser commitado.

# SMTP (Gmail) — credenciais do remetente.
# Para Gmail: ative 2FA na conta e gere uma App Password em
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Destinatário das notificações por e-mail.
NOTIFICATION_MAIL_TO=destinatario@example.com
