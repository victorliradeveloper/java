# Copie este arquivo pra `.env` (na mesma pasta) e preencha com valores reais.
# `.env` NAO eh commitado (ver .gitignore).
#
# O docker-compose.yml carrega esses valores automaticamente do .env quando voce
# roda `docker-compose up` a partir desta pasta.

# === SMTP (Gmail recomendado pra dev) ===
# 1. Ative 2FA em https://myaccount.google.com/security
# 2. Gere uma App Password em https://myaccount.google.com/apppasswords
# 3. Cole abaixo (sem espacos)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-app-password-de-16-chars

# === Destinatario das notificacoes ===
# Pode ser igual ao SMTP_USER pra teste, ou outro endereco.
NOTIFICATION_MAIL_TO=destinatario@exemplo.com
